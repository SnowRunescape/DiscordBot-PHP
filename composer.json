{
  "name": "snowrunescape/discord-bot-php",
  "description": "Discord Bot PHP",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Bruno Caitano",
      "email": "snowrunescape@snowdev.com.br",
      "role": "Owner",
      "homepage": "https://snowdev.com.br"
    }
  ],
  "autoload": {
    "psr-4": {
      "DiscordPHP\\": "src/"
    }
  },
  "require": {
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "php": "^7.4 || ^8.0",
    "textalk/websocket": "^1.6.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.33",
    "friendsofphp/php-cs-fixer": "^3.66"
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "7.4.0"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit --do-not-cache-result"
  }
}
